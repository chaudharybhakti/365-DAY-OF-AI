   "source": [
    "import numpy as np\n",
    "\n",
    "arr = np.array([10, 20, 30, 40, 50, 60])\n",
    "\n",
    "print(arr[1:5])      # [20 30 40 50] (index 1 to 4)\n",
    "print(arr[:3])       # [10 20 30]    (first 3 elements)\n",
    "print(arr[::2])      # [10 30 50]    (every second element)\n",
    "print(arr[::-1])"
   ]
  }
